{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-boat.local/schema/display-v1.schema.json",
  "title": "Semantic Boat display configuration v1",
  "type": "object",
  "required": ["schema", "sections"],
  "properties": {
    "schema": { "const": "semantic-display/v1" },
    "name": { "type": "string" },
    "permanent_sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "default": "signalk" },
        "path": { "type": "string", "minLength": 1 },
        "unit": { "type": "string" },
        "stale_ms": { "type": "integer", "minimum": 0 },
        "subscribe": {
          "type": "object",
          "properties": {
            "period_ms": { "type": "integer", "minimum": 0 }
          }
        },
        "history": {
          "type": "object",
          "required": ["interval_ms", "points"],
          "properties": {
            "interval_ms": { "type": "integer", "minimum": 1 },
            "points": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "reducer": {
              "enum": ["last", "mean", "minimum", "maximum"],
              "default": "last"
            }
          }
        }
      },
      "additionalProperties": true
    },
    "cell": {
      "type": "object",
      "required": ["column", "row"],
      "properties": {
        "column": { "type": "integer", "minimum": 0, "maximum": 255 },
        "row": { "type": "integer", "minimum": 0, "maximum": 255 },
        "column_span": { "type": "integer", "minimum": 1, "maximum": 255, "default": 1 },
        "row_span": { "type": "integer", "minimum": 1, "maximum": 255, "default": 1 }
      }
    },
    "widget": {
      "type": "object",
      "required": ["type", "cell"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "cell": { "$ref": "#/$defs/cell" },
        "label": { "type": "string" },
        "display_unit": { "type": "string" },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 6 },
        "text": { "type": "string" }
      },
      "additionalProperties": true
    },
    "page": {
      "type": "object",
      "required": ["id", "grid", "widgets"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "grid": {
          "type": "object",
          "required": ["columns", "rows"],
          "properties": {
            "columns": { "type": "integer", "minimum": 1, "maximum": 255 },
            "rows": { "type": "integer", "minimum": 1, "maximum": 255 },
            "gap": { "type": "integer", "minimum": 0, "maximum": 255, "default": 0 }
          }
        },
        "widgets": {
          "type": "array",
          "items": { "$ref": "#/$defs/widget" }
        }
      },
      "additionalProperties": true
    },
    "section": {
      "type": "object",
      "required": ["id", "pages"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "button_labels": {
          "type": "object",
          "properties": {
            "action_1": { "type": "string" },
            "action_2": { "type": "string" }
          },
          "additionalProperties": true
        },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" }
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/page" }
        }
      },
      "additionalProperties": true
    }
  }
}
