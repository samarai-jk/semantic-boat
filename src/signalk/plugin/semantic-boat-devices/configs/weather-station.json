{
  "schema": "semantic-display/v1",
  "name": "Weather Station",
  "permanent_sources": [
    {"id": "wind-speed", "provider": "signalk", "path": "environment.weather.wind.speed", "unit": "m/s", "stale_ms": 10000, "history": {"interval_ms": 10000, "points": 56, "reducer": "maximum"}},
    {"id": "temperature", "provider": "signalk", "path": "environment.weather.air.temperature", "unit": "K", "stale_ms": 10000, "history": {"interval_ms": 60000, "points": 56, "reducer": "mean"}},
    {"id": "pressure", "provider": "signalk", "path": "environment.weather.air.pressure", "unit": "Pa", "stale_ms": 10000, "history": {"interval_ms": 60000, "points": 56, "reducer": "mean"}},
    {"id": "pm25", "provider": "signalk-ugm3", "path": "environment.weather.air.pm25", "unit": "ug/m3", "stale_ms": 10000, "history": {"interval_ms": 60000, "points": 56, "reducer": "maximum"}}
  ],
