          {"type": "value", "source": "wind-direction", "label": "SENSOR DIRECTION", "display_unit": "deg", "decimals": 0, "cell": {"column": 0, "row": 1}},
          {"type": "value", "source": "wind-sector", "label": "DIRECTION SECTOR", "decimals": 0, "cell": {"column": 1, "row": 1}}
        ]
      }]
    },
