    {
      "label": "Serial log (ST-Link VCP)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\script\\serial-log.ps1"
      ],
      "linux": {
        "command": "${workspaceFolder}/script/serial-log.sh",
        "args": []
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
