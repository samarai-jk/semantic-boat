  "buildPresets": [
    { "name": "remote-a-debug", "configurePreset": "remote-a-debug" },
    { "name": "remote-a-release", "configurePreset": "remote-a-release" },
    { "name": "lab-test-01-debug", "configurePreset": "lab-test-01-debug" },
    { "name": "lab-test-01-release", "configurePreset": "lab-test-01-release" }
