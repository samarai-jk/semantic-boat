          {"type": "value", "source": "available", "label": "AVAILABLE", "max_digits": 5, "cell": {"column": 1, "row": 0}},
          {"type": "value", "source": "last-read", "label": "LAST READ UTC", "max_digits": 24, "cell": {"column": 0, "row": 1, "column_span": 2}}
