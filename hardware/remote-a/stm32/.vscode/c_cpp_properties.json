{
  "configurations": [
    {
      "name": "STM32L431 (GNU Arm)",
      "compilerPath": "${env:USERPROFILE}/scoop/apps/gcc-arm-none-eabi/current/bin/arm-none-eabi-gcc.exe",
      "compilerArgs": [
        "-mcpu=cortex-m4",
        "-mthumb",
        "-mfpu=fpv4-sp-d16",
        "-mfloat-abi=hard"
      ],
      "defines": [
        "USE_HAL_DRIVER",
        "STM32L431xx"
      ],
      "includePath": [
        "${workspaceFolder}/Core/Inc",
        "${workspaceFolder}/Drivers/STM32L4xx_HAL_Driver/Inc",
        "${workspaceFolder}/Drivers/STM32L4xx_HAL_Driver/Inc/Legacy",
        "${workspaceFolder}/Drivers/CMSIS/Device/ST/STM32L4xx/Include",
        "${workspaceFolder}/Drivers/CMSIS/Include"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/Core/Inc",
          "${workspaceFolder}/Drivers/STM32L4xx_HAL_Driver/Inc",
          "${workspaceFolder}/Drivers/CMSIS/Device/ST/STM32L4xx/Include",
          "${workspaceFolder}/Drivers/CMSIS/Include"
        ],
        "limitSymbolsToIncludedHeaders": true
      },
      "cStandard": "gnu23",
      "intelliSenseMode": "windows-gcc-arm"
    }
  ],
  "version": 4
}
