            {"type": "value", "source": "client-uptime", "cell": {"column": 1, "row": 1}, "label": "UPTIME", "display_unit": "h", "decimals": 1}
          ]
        },
        {
          "id": "software",
          "title": "SOFTWARE",
          "grid": {"columns": 2, "rows": 1, "gap": 4},
          "widgets": [
            {"type": "value", "source": "firmware", "cell": {"column": 0, "row": 0}, "label": "FIRMWARE"},
            {"type": "local-clock", "cell": {"column": 1, "row": 0}, "label": "LOCAL TIME"}
          ]
