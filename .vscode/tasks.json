{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build remote-a (Debug)",
      "type": "shell",
      "command": "${workspaceFolder}\\script\\build.bat",
      "linux": {
        "command": "${workspaceFolder}/script/build.sh"
      },
      "args": [
        "remote-a",
        "debug",
        "refresh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
