        {"id": "coarse-illuminance", "provider": "signalk", "path": "environment.weather.light.coarseIlluminance", "unit": "lux", "stale_ms": 10000},
        {"id": "solar", "provider": "signalk", "path": "environment.weather.solar.irradiance", "unit": "W/m2", "stale_ms": 10000},
        {"id": "rain", "provider": "signalk", "path": "environment.weather.rain.accumulation", "unit": "m", "stale_ms": 10000}
      ],
      "pages": [{
        "id": "light-rain", "title": "LIGHT AND RAIN", "grid": {"columns": 2, "rows": 2, "gap": 4},
        "widgets": [
          {"type": "value", "source": "illuminance", "label": "ILLUMINANCE", "display_unit": "lux", "decimals": 0, "max_digits": 7, "cell": {"column": 0, "row": 0}},
          {"type": "value", "source": "coarse-illuminance", "label": "COARSE LIGHT", "display_unit": "lux", "decimals": 0, "max_digits": 7, "cell": {"column": 1, "row": 0}},
          {"type": "value", "source": "solar", "label": "SOLAR IRRADIANCE", "display_unit": "W/m2", "decimals": 0, "cell": {"column": 0, "row": 1}},
          {"type": "value", "source": "rain", "label": "TOTAL RAIN", "display_unit": "m", "decimals": 4, "max_digits": 8, "cell": {"column": 1, "row": 1}}
        ]
      }]
    },
    {
      "id": "weather-station", "title": "STATION STATUS", "button_labels": {"action_2": "REFRESH"},
      "sources": [
        {"id": "compass", "provider": "signalk", "path": "environment.weather.compass.angle", "unit": "rad", "stale_ms": 10000},
        {"id": "available", "provider": "signalk-text", "path": "environment.weather.status.available", "stale_ms": 10000},
        {"id": "last-read", "provider": "signalk", "path": "environment.weather.status.lastSuccessfulRead"}
