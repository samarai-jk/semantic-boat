{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build remote-a (Debug)",
      "type": "shell",
      "command": "${workspaceFolder}\\script\\build.bat",
      "linux": {
        "command": "${workspaceFolder}/script/build.sh"
      },
      "args": [
        "remote-a",
        "debug",
        "refresh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Build remote-a (Release)",
      "type": "shell",
      "command": "${workspaceFolder}\\script\\build.bat",
      "linux": {
        "command": "${workspaceFolder}/script/build.sh"
      },
      "args": [
        "remote-a",
        "release",
        "refresh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Flash remote-a (Debug)",
      "type": "shell",
      "command": "${workspaceFolder}\\script\\build.bat",
      "linux": {
        "command": "${workspaceFolder}/script/build.sh"
      },
      "args": [
        "remote-a",
        "debug",
        "refresh",
        "flash"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Build lab-test-01 (Debug)",
      "type": "shell",
      "command": "${workspaceFolder}\\script\\build.bat",
      "linux": {
        "command": "${workspaceFolder}/script/build.sh"
      },
      "args": [
        "lab-test-01",
        "debug",
        "refresh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Build lab-test-01 (Release)",
      "type": "shell",
      "command": "${workspaceFolder}\\script\\build.bat",
      "linux": {
        "command": "${workspaceFolder}/script/build.sh"
      },
      "args": [
        "lab-test-01",
        "release",
        "refresh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Flash lab-test-01 (Debug)",
      "type": "shell",
      "command": "${workspaceFolder}\\script\\build.bat",
      "linux": {
        "command": "${workspaceFolder}/script/build.sh"
      },
      "args": [
        "lab-test-01",
        "debug",
        "refresh",
        "flash"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Serial log (ST-Link VCP)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\script\\serial-log.ps1"
      ],
      "linux": {
        "command": "${workspaceFolder}/script/serial-log.sh",
        "args": []
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      }
    },
    {
      "label": "SWD probe (can-mcu)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\script\\swd-probe.ps1",
        "${input:swdProbe}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      }
    },
    {
      "label": "SWD log (follow)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/script/swd-probe.ps1",
        "-Follow"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      }
    },
    {
      "label": "Monitor (can-mcu events)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/script/monitor.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    }
  ],
  "inputs": [
    {
      "id": "swdProbe",
      "type": "pickString",
      "description": "Which probe?",
      "options": [
        "all",
        "pins",
        "inputs",
        "can"
      ],
      "default": "all"
    }
  ]
}
